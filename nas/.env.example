# Copy to .env and edit. .env stays out of git.

# Mode. Empty: gateway (SeedLink served from this host). relay: also run the
# SSH tunnel and slink2dali to the VPS relay (see the Relay section below).
COMPOSE_PROFILES=

# Where the containers keep their data. Owned by uid 10000.
# QNAP: /share/Container/vseismo/data. Debian PC: /srv/vseismo/data
DATA_ROOT=/share/Container/vseismo/data

# Days of SDS archive to keep (about 30 MB a day). 0 keeps everything.
SDS_KEEP_DAYS=365

# This host's LAN address: SeedLink (18000) and bridge metrics (9108) bind here only.
LAN_ADDR=192.168.1.20

# Station
VSEISMO_URL=http://192.168.1.50
# Only with login=1 on the station:
#VSEISMO_USER=admin
#VSEISMO_PASS=

# SEED codes. NET XX is the FDSN test code: keep it until a network assigns
# one. STA matches the station's "station" setting.
SEED_NET=XX
SEED_STA=VSEIS
SEED_LOC=00
# Channel 0 (vertical) and channel 1 (horizontal, azimuth not yet measured)
SEED_CHAN=EHZ,EH1

# Bridge timing
POLL_S=1.0
# Longest a partial 512-byte record waits before it is sent
FLUSH_S=10
JOURNAL_DAYS=60
LOG_LEVEL=INFO

# Relay (outbound SSH tunnel to the VPS), used with COMPOSE_PROFILES=relay
RELAY_HOST=relay.example.org
RELAY_USER=seismo
RELAY_SSH_PORT=22
