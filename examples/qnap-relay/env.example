# gateway/.env for a QNAP NAS in relay mode. Copy to gateway/.env and edit.

COMPOSE_PROFILES=relay

# Container Station keeps data on a share. Owned by uid 10000.
DATA_ROOT=/share/Container/vseismo/data
SDS_KEEP_DAYS=365

# NAS LAN address: LAN SeedLink (18000) and bridge metrics (9108) bind here only.
LAN_ADDR=192.168.1.20

# Station
VSEISMO_URL=http://192.168.1.50
# Only with login=1 on the station:
#VSEISMO_USER=admin
#VSEISMO_PASS=

SEED_NET=XX
SEED_STA=VSEIS
SEED_LOC=00
SEED_CHAN=EHZ,EH1

POLL_S=1.0
FLUSH_S=10
JOURNAL_DAYS=60
LOG_LEVEL=INFO

# The VPS from ../vps-relay/
RELAY_HOST=relay.example.org
RELAY_USER=seismo
RELAY_SSH_PORT=22
